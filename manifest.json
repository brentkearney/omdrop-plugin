{
  "schemaVersion": 1,
  "id": "netmojo.omdrop",
  "name": "omdrop",
  "version": "0.3.1",
  "author": "Brent Kearney",
  "license": "MIT",
  "description": "Receive files from nearby Apple devices over AirDrop, on Apple Silicon Macs running Omarchy.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "omdrop",
    "description": "Become visible to nearby Apple devices for a bounded window and receive what they send.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "windowMinutes": 10
    },
    "schema": [
      {
        "key": "windowMinutes",
        "type": "integer",
        "label": "Receive window (minutes)",
        "min": 1,
        "max": 120,
        "step": 1,
        "defaultValue": 10
      }
    ]
  }
}
